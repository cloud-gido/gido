# Kind 本机开发：Flink 运行时镜像（复制为 k8s/kind-local.env 后按需修改）
#
#   cp k8s/kind-local.env.example k8s/kind-local.env
#   bash k8s/deploy-kind-windows.sh   # Windows Git Bash
#   KUBECONFIG=~/.kube/kind-gido.yaml bash k8s/apply-gido-stack.sh
#
# dev-1 CI 推送路径（按 Flink 基座版本分仓库）：
#   ghcr.io/<owner>/<repo>/dev-1/flink-runtime/2.2.1:dev-1
#   ghcr.io/<owner>/<repo>/dev-1/flink-runtime/1.17.2:dev-1
#   ghcr.io/<owner>/<repo>/dev-1/flink-runtime/2.0.1:dev-1

# 使用 GHCR dev-1 全栈（跳过本地 build）：
# GIDO_BACKEND_IMAGE=ghcr.io/cloud-gido/gido/dev-1/gido-backend:dev-1-<sha>
# GIDO_FRONTEND_IMAGE=ghcr.io/cloud-gido/gido/dev-1/gido-frontend:dev-1-<sha>
# GIDO_FLINK_OPERATOR_IMAGE=ghcr.io/cloud-gido/gido/dev-1/flink-runtime/1.17.2:dev-1-<sha>
# GIDO_FLINK_OPERATOR_FLINK_VERSION=v1_17
# GIDO_SKIP_BUILD=1

GIDO_FLINK_OPERATOR_IMAGE=ghcr.io/cloud-gido/gido/dev-1/flink-runtime/2.2.1:dev-1
GIDO_SKIP_FLINK_BUILD=1
