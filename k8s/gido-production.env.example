# GIDO 生产部署变量（复制为 k8s/gido-production.env，建议 gitignore 勿提交）
#
#   cp k8s/gido-production.env.example k8s/gido-production.env
#   bash k8s/apply-gido-production.sh
#
# 前置：Flink Kubernetes Operator 1.15 已 Helm 安装（见 gido-production-external-pg.yaml 头部）

# --- GHCR CI 镜像 ---
GIDO_GHCR_REPO=ghcr.io/cloud-gido/gido
GIDO_CI_PROFILE=dev-1
GIDO_IMAGE_TAG=dev-1
GIDO_FLINK_RUNTIME_VERSION=2.2.1
GIDO_FLINK_RUNTIME_TAG=
GIDO_FLINK_OPERATOR_FLINK_VERSION=v2_2

# --- 外置 PostgreSQL（必填）---
GIDO_PG_HOST=postgres.example.internal
GIDO_PG_PORT=5432
GIDO_PG_USER=gido
GIDO_PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GIDO_PG_DB=gido

# --- 应用密钥（必填）---
GIDO_SECRET_KEY=CHANGE_ME_JWT_SECRET_48_CHARS_MINIMUM_ROTATE_IN_PROD
GIDO_ARTIFACT_TOKEN=CHANGE_ME_FLINK_ARTIFACT_TOKEN_32_CHARS
GIDO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- S3 制品库（可选；留空 GIDO_S3_BUCKET 则仅用 PVC + HTTP 拉取 JAR）---
# 示例（与 Flink resource.* 对齐）：
#   GIDO_S3_BUCKET=flink-on-devtest
#   GIDO_S3_JAR_PREFIX=gido-flink
#   GIDO_S3_REGION=ap-southeast-1
#   GIDO_S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
GIDO_S3_BUCKET=
GIDO_S3_JAR_PREFIX=gido-flink
GIDO_S3_REGION=
GIDO_S3_ENDPOINT_URL=
# irsa | static（非 EKS 一般用 static，AK/SK 写入 gido-secrets 或 gido-s3-credentials Secret）
GIDO_S3_AUTH_MODE=static
GIDO_S3_USE_IRSA=false

# --- 可选 ---
GIDO_STORAGE_CLASS=
GIDO_IMAGE_PULL_SECRET=ghcr-pull
GIDO_FLINK_IMAGE_PULL_SECRETS=ghcr-pull
# GIDO_RENDERED_MANIFEST=/tmp/gido-production.rendered.yaml
